<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CivicPulse AI · Datos Abiertos</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Iconos de Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

  <!-- 1. BARRA SUPERIOR -->
  <nav class="navbar border-bottom border-secondary-subtle bg-black bg-opacity-25 px-3 py-2">
    <div class="container-fluid d-flex justify-content-between align-items-center gap-3">
      
      <!-- Logo -->
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2 m-0" href="#">
        <i class="bi bi-broadcast text-warning fs-4"></i>
        <span>CivicPulse <span class="text-warning">AI</span></span>
      </a>

      <!-- Etiqueta de fuente oficial -->
      <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle d-none d-md-inline-block">
        <i class="bi bi-database-check me-1"></i>Datos Abiertos · INE
      </span>

    </div>
  </nav>

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="container-fluid p-3 p-lg-4">

    <!-- 2. PANEL DE FILTROS (TARJETA HORIZONTAL) -->
    <div class="card bg-body-tertiary border-secondary-subtle rounded-4 shadow-sm mb-4">
      <div class="card-body p-3">
        <form id="filtrosForm" class="row g-3 align-items-end" method="POST">
          <!-- Filtro 1: Sexo -->
          <div class="col-md-3">
            <label for="sexo" class="form-label small text-secondary fw-semibold mb-1">
              <i class="bi bi-people me-1 text-warning"></i>Sexo
            </label>
            <select id="sexo" name="sexo" class="form-select form-select-sm bg-dark border-secondary">
              <option value="Ambos sexos">Ambos sexos</option>
              <option value="Hombres">Hombres</option>
              <option value="Mujeres">Mujeres</option>
            </select>
          </div>

          <!-- Filtro 2: Edad -->
          <div class="col-md-3">
            <label for="edad" class="form-label small text-secondary fw-semibold mb-1">
              <i class="bi bi-person-badge me-1 text-warning"></i>Edad
            </label>
            <select id="edad" name="edad" class="form-select form-select-sm bg-dark border-secondary">
              <option value="Total">Total</option>
              <option value="Menores de 16">Menores de 16</option>
              <option value="De 16 a 19 años">De 16 a 19 años</option>
              <option value="De 20 a 24 años">De 20 a 24 años</option>
              <option value="De 25 a 34 años">De 25 a 34 años</option>
              <option value="De 35 a 44 años">De 35 a 44 años</option>
              <option value="De 45 a 54 años">De 45 a 54 años</option>
              <option value="De 55 a 64 años">De 55 a 64 años</option>
              <option value="65 y más años">65 y más años</option>
            </select>
          </div>

          <!-- Filtro 3: Comunidades -->
          <div class="col-md-3">
            <label for="comunidad" class="form-label small text-secondary fw-semibold mb-1">
              <i class="bi bi-geo-alt me-1 text-warning"></i>Comunidad Autónoma
            </label>
            <select id="comunidad" name="comunidad" class="form-select form-select-sm bg-dark border-secondary">
              <option value="Total Nacional">Total Nacional</option>
              <option value="01 Andalucía">01 Andalucía</option>
              <option value="02 Aragón">02 Aragón</option>
              <option value="03 Asturias, Principado de">03 Asturias, Principado de</option>
              <option value="04 Balears, Illes">04 Balears, Illes</option>
              <option value="05 Canarias">05 Canarias</option>
              <option value="06 Cantabria">06 Cantabria</option>
              <option value="07 Castilla y León">07 Castilla y León</option>
              <option value="08 Castilla - La Mancha">08 Castilla - La Mancha</option>
              <option value="09 Cataluña">09 Cataluña</option>
              <option value="10 Comunitat Valenciana">10 Comunitat Valenciana</option>
              <option value="11 Extremadura">11 Extremadura</option>
              <option value="12 Galicia">12 Galicia</option>
              <option value="13 Madrid, Comunidad de">13 Madrid, Comunidad de</option>
              <option value="14 Murcia, Región de">14 Murcia, Región de</option>
              <option value="15 Navarra, Comunidad Foral de">15 Navarra, Comunidad Foral de</option>
              <option value="16 País Vasco">16 País Vasco</option>
              <option value="17 Rioja, La">17 Rioja, La</option>
              <option value="18 Ceuta">18 Ceuta</option>
              <option value="19 Melilla">19 Melilla</option>
            </select>
          </div>

          <!-- Botón Mostrar resultados -->
          <div class="col-md-3">
            <button type="submit" id="btnMostrar" class="btn btn-warning btn-sm fw-semibold w-100">
              <i class="bi bi-bar-chart-line me-1"></i>Mostrar resultados
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- 3. ZONA DE RESULTADOS (IZQUIERDA VISUAL / DERECHA TARJETAS) -->
    <div class="row g-4">
      
      <!-- Columna izquierda (65%): Gráfica de evolución -->
      <div class="col-lg-8">
        <div class="card bg-body-tertiary border-secondary-subtle rounded-4 h-100">
          <div class="card-body p-4">
            <h5 class="fw-semibold mb-3" id="tituloGrafica">Evolución histórica (2006 - 2025)</h5>
            <!-- Este div con altura fija evita que la gráfica crezca sin parar -->
            <div style="height: 350px; position: relative;">
              <canvas
                id="graficaEvolucion"
                data-series="<%= JSON.stringify(typeof resultados === 'undefined' ? [] : resultados.map(serie => ({ label: serie.Nombre.trim(), data: serie.Data.slice().reverse().map(dato => ({ year: dato.Anyo, value: dato.Valor })) }))) %>"
                aria-label="Gráfica de evolución demográfica por año"
                role="img"></canvas>
            </div>
            <p id="graficaMensaje" class="text-secondary small mt-3 mb-0" aria-live="polite">
              Envía una consulta para ver la evolución de los datos.
            </p>
          </div>
        </div>
      </div>

      <!-- Columna derecha (35%): Tarjetas Bento de decisión -->
      <div class="col-lg-4 d-flex flex-column gap-3">
        
        <!-- Tarjeta destacada de Recomendación / Análisis -->
        <div class="card bg-body-tertiary border-warning rounded-4 shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center gap-2 text-warning small fw-semibold mb-1">
              <i class="bi bi-lightbulb-fill"></i>
              <span>Análisis Inteligente</span>
            </div>
            <h5 class="fw-bold mb-1" id="tituloZona">Total Nacional · 2025</h5>
            <p class="text-light-emphasis small mb-0" id="textoRecomendacion">
              Selecciona una comunidad autónoma o tramo de edad para comparar su evolución respecto a la media nacional.
            </p>
          </div>
        </div>

        <div class="card bg-body-tertiary border-secondary-subtle rounded-4">
          <div class="card-body">
            <span class="text-secondary small d-block mb-1">
              Último dato · <span id="kpiAnio">—</span>
            </span>

            <div class="d-flex align-items-baseline gap-2 flex-wrap">
              <span class="display-6 fw-bold" id="kpiValor">—</span>
              <span class="badge rounded-pill" id="kpiVariacion"></span>
            </div>
            <div class="text-secondary small" id="kpiVariacionTexto">vs. año anterior</div>

            <hr class="border-secondary-subtle my-3">

            <div class="row g-2 small">
              <div class="col-12 d-flex justify-content-between">
                <span class="text-secondary">Vs. Total Nacional</span>
                <span class="fw-semibold" id="kpiVsNacional">—</span>
              </div>
              <div class="col-12 d-flex justify-content-between">
                <span class="text-secondary">Máximo histórico</span>
                <span class="fw-semibold" id="kpiMax">—</span>
              </div>
              <div class="col-12 d-flex justify-content-between">
                <span class="text-secondary">Mínimo histórico</span>
                <span class="fw-semibold" id="kpiMin">—</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/consulta-chart.js"></script>
</body>
</html>