<%
  const territorios = [
    ['Total Nacional', 'Total Nacional', ''],
    ['Andalucía', 'Andalucía', 'andalucia'],
    ['Aragón', 'Aragón', 'aragon'],
    ['Asturias, Principado de', 'Principado de Asturias', 'asturias'],
    ['Balears, Illes', 'Islas Baleares', 'baleares'],
    ['Canarias', 'Canarias', 'canarias'],
    ['Cantabria', 'Cantabria', 'cantabria'],
    ['Castilla y León', 'Castilla y León', 'castilla-leon'],
    ['Castilla - La Mancha', 'Castilla-La Mancha', 'castilla-la-mancha'],
    ['Cataluña', 'Cataluña', 'cataluna'],
    ['Comunitat Valenciana', 'Comunidad Valenciana', 'comunidad-valenciana'],
    ['Extremadura', 'Extremadura', 'extremadura'],
    ['Galicia', 'Galicia', 'galicia'],
    ['Madrid, Comunidad de', 'Comunidad de Madrid', 'madrid'],
    ['Murcia, Región de', 'Región de Murcia', 'murcia'],
    ['Navarra, Comunidad Foral de', 'Comunidad Foral de Navarra', 'navarra'],
    ['País Vasco', 'País Vasco', 'pais-vasco'],
    ['Rioja, La', 'La Rioja', 'rioja'],
    ['Ceuta', 'Ceuta', 'ceuta'],
    ['Melilla', 'Melilla', 'melilla']
  ];
  const sexos = ['Ambos sexos', 'Hombres', 'Mujeres'];
  const edades = [
    'Total',
    'Menores de 16',
    'De 16 a 19 años',
    'De 20 a 24 años',
    'De 25 a 34 años',
    'De 35 a 44 años',
    'De 45 a 54 años',
    'De 55 a 64 años',
    '65 y más años'
  ];
%>
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CivicPulse AI · Datos Abiertos</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Iconos de Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    .mapa-espana { display: block; width: 100%; max-height: 350px; }
    .mapa-inset-canarias {
      fill: rgba(13, 202, 240, .035);
      stroke: #71808d;
      stroke-width: 1.5;
      vector-effect: non-scaling-stroke;
    }
    .mapa-inset-etiqueta {
      fill: #adb5bd;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
    }
    .mapa-region, .mapa-marcador {
      fill: #263746;
      stroke: #80909d;
      stroke-width: 1.4;
      vector-effect: non-scaling-stroke;
      transition: fill .2s ease, stroke .2s ease;
    }
    .mapa-region.is-seleccion-1, .mapa-marcador.is-seleccion-1 {
      fill: #ffc107;
      stroke: #fff3cd;
    }
    .mapa-region.is-seleccion-2, .mapa-marcador.is-seleccion-2 {
      fill: #0dcaf0;
      stroke: #cff4fc;
    }
    .mapa-region.is-seleccion-ambas, .mapa-marcador.is-seleccion-ambas {
      fill: url(#mapa-doble);
      stroke: #f8f9fa;
      stroke-width: 2;
    }
    .mapa-clave { width: .65rem; height: .65rem; border-radius: 50%; flex: 0 0 auto; }
    .mapa-clave-1 { background: #ffc107; }
    .mapa-clave-2 { background: #0dcaf0; }
  </style>
</head>
<body class="bg-dark text-light">

  <!-- 1. BARRA SUPERIOR -->
  <nav class="navbar border-bottom border-secondary-subtle bg-black bg-opacity-25 px-3 py-2">
    <div class="container-fluid d-flex justify-content-between align-items-center gap-3">
      
      <!-- Logo -->
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2 m-0" href="#">
        <i class="bi bi-broadcast text-warning fs-4"></i>
        <span>CivicPulse <span class="text-warning">AI</span></span>
      </a>

      <!-- Etiqueta de fuente oficial -->
      <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle d-none d-md-inline-block">
        <i class="bi bi-database-check me-1"></i>Datos Abiertos · INE
      </span>

    </div>
  </nav>

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="container-fluid p-3 p-lg-4">

    <!-- 2. PANEL DE FILTROS (TARJETA HORIZONTAL) -->
    <div class="card bg-body-tertiary border-secondary-subtle rounded-4 shadow-sm mb-4">
      <div class="card-body p-3">
        <form id="filtrosForm" class="row g-3 align-items-end" method="POST">
          <div class="col-12">
            <fieldset>
              <legend class="h6 text-warning mb-2">Modo de consulta</legend>
              <div class="btn-group" role="group" aria-label="Modo de consulta">
                <input type="radio" class="btn-check" name="modo" id="modoIndividual" value="individual"
                  <%= (filtros.modo || 'individual') === 'individual' ? 'checked' : '' %>>
                <label class="btn btn-outline-warning btn-sm" for="modoIndividual">
                  <i class="bi bi-person me-1"></i>Una selección
                </label>
                <input type="radio" class="btn-check" name="modo" id="modoComparar" value="comparar"
                  <%= filtros.modo === 'comparar' ? 'checked' : '' %>>
                <label class="btn btn-outline-warning btn-sm" for="modoComparar">
                  <i class="bi bi-people me-1"></i>Comparar dos
                </label>
              </div>
            </fieldset>
          </div>
          <% [1, 2].forEach(numero => { %>
          <div class="col-12" data-seleccion="<%= numero %>">
            <h2 class="h6 text-warning mb-2">Selección <%= numero %></h2>
            <div class="row g-3">
              <div class="col-md-4">
                <label for="sexo<%= numero %>" class="form-label small text-secondary">Sexo</label>
                <select id="sexo<%= numero %>" name="sexo<%= numero %>" class="form-select form-select-sm bg-dark border-secondary" required>
                  <% sexos.forEach(sexo => { %>
                    <option value="<%= sexo %>" <%= filtros[`sexo${numero}`] === sexo ? 'selected' : '' %>><%= sexo %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-4">
                <label for="comunidad<%= numero %>" class="form-label small text-secondary">Territorio</label>
                <select id="comunidad<%= numero %>" name="comunidad<%= numero %>" class="form-select form-select-sm bg-dark border-secondary" required>
                  <% territorios.forEach(([valor, nombre, idMapa]) => { %>
                    <option value="<%= valor %>" data-mapa="<%= idMapa %>" <%= filtros[`comunidad${numero}`] === valor ? 'selected' : '' %>><%= nombre %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-4">
                <label for="edad<%= numero %>" class="form-label small text-secondary">Edad</label>
                <select id="edad<%= numero %>" name="edad<%= numero %>" class="form-select form-select-sm bg-dark border-secondary" required>
                  <% edades.forEach(edad => { %>
                    <option value="<%= edad %>" <%= filtros[`edad${numero}`] === edad ? 'selected' : '' %>><%= edad %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
          <% }); %>
          <div class="col-12">
            <button type="submit" id="btnMostrar" class="btn btn-warning btn-sm fw-semibold w-100">
              <i class="bi bi-bar-chart-line me-1"></i><span id="btnMostrarTexto">Ver selección</span>
            </button>
          </div>
        </form>
      </div>
    </div>
    <% if (typeof error !== 'undefined') { %>
      <div class="alert alert-warning" role="alert"><%= error %></div>
    <% } %>

    <!-- 3. ZONA DE RESULTADOS (IZQUIERDA VISUAL / DERECHA TARJETAS) -->
    <div class="row g-4">
      
      <!-- Columna izquierda: Comparación de áreas -->
      <div class="col-lg-8">
        <div class="card bg-body-tertiary border-secondary-subtle rounded-4 mb-4">
          <div class="card-body p-4">
            <h5 class="fw-semibold mb-3" id="graficaTitulo">Evolución de la selección</h5>
            <div style="height: 480px; position: relative;">
              <canvas
                id="graficaComparacion"
                data-series="<%= JSON.stringify(resultados.map(resultado => ({ label: resultado.etiqueta, data: resultado.series[0]?.Data.slice().reverse().map(dato => ({ year: dato.Anyo, value: dato.Valor })) || [] }))) %>"
                data-kpis="<%= JSON.stringify(resultados.map(resultado => resultado.kpis || null)) %>"
                aria-label="Gráfica de áreas apiladas comparando las dos selecciones"
                role="img"></canvas>
            </div>
            <p id="graficaMensaje" class="text-secondary small mt-3 mb-0" aria-live="polite">
            Envía una selección para ver sus datos.
            </p>
          </div>
        </div>
      </div>

      <!-- Columna derecha (35%): Tarjetas Bento de decisión -->
      <div class="col-lg-4 d-flex flex-column gap-3">
        <% [1, 2].forEach((numero, indice) => { %>
          <% const resultado = resultados[indice]; %>
          <article class="card bg-body-tertiary border-secondary-subtle rounded-4 overflow-hidden" data-tarjeta="<%= numero %>">
            <div class="card-header border-secondary-subtle bg-<%= indice === 0 ? 'warning' : 'info' %>-subtle bg-opacity-10 px-3 py-2">
              <div class="d-flex align-items-center justify-content-between gap-2">
                <span class="text-<%= indice === 0 ? 'warning' : 'info' %> fw-semibold small">
                  <i class="bi <%= indice === 0 ? 'bi-1-circle' : 'bi-2-circle' %> me-1"></i>
                  Selección <%= numero %>
                </span>
                <span class="text-secondary small text-end text-wrap flex-shrink-1" style="min-width: 0; max-width: 70%;" data-kpi-etiqueta="<%= numero %>">
                  <%= resultado?.etiqueta || 'Sin selección' %>
                </span>
              </div>
            </div>
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <span class="text-secondary small">
                  Último dato · <span class="fw-semibold" id="kpiAnio<%= numero %>">—</span>
                </span>
              </div>

              <div class="d-flex align-items-baseline gap-2 flex-wrap mb-1">
                <span class="display-6 fw-bold lh-1" id="kpiValor<%= numero %>">—</span>
              </div>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="text-secondary small" id="kpiVariacionTexto<%= numero %>">vs. año anterior</span>
                <span class="badge rounded-pill" id="kpiVariacionMovil<%= numero %>"></span>
              </div>

              <hr class="border-secondary-subtle my-3">

              <div class="row g-2 small">
                <div class="col-12 d-flex justify-content-between align-items-center gap-2">
                  <span class="text-secondary" id="kpiHistoricoTexto<%= numero %>">2025 vs. 2006</span>
                  <span class="badge rounded-pill" id="kpiHistoricoVariacion<%= numero %>">—</span>
                </div>
                <div class="col-12 d-flex justify-content-between align-items-center gap-2">
                  <span class="text-secondary">
                    <i class="bi bi-arrow-up-right text-success me-1"></i>Máximo histórico
                  </span>
                  <span class="fw-semibold text-end" id="kpiMax<%= numero %>">—</span>
                </div>
                <div class="col-12 d-flex justify-content-between align-items-center gap-2">
                  <span class="text-secondary">
                    <i class="bi bi-arrow-down-right text-danger me-1"></i>Mínimo histórico
                  </span>
                  <span class="fw-semibold text-end" id="kpiMin<%= numero %>">—</span>
                </div>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </div>

    <section class="card bg-body-tertiary border-secondary-subtle rounded-4 mt-4" aria-labelledby="mapaTituloTarjeta">
      <div class="card-body p-3 p-lg-4">
        <div class="row g-4 align-items-center">
          <div class="col-lg-8">
            <h2 class="h5 fw-semibold mb-2" id="mapaTituloTarjeta">Ubicación de las selecciones</h2>
            <p class="text-secondary small mb-3">El mapa resalta las comunidades o ciudades autónomas elegidas en los filtros.</p>
            <div id="mapaEspana">
              <%- include('mapa-comunidades') %>
            </div>
            <p class="text-secondary small mb-0">
              Cartografía adaptada de
              <a href="https://github.com/codeforgermany/click_that_hood/blob/main/public/data/spain-communities.geojson" target="_blank" rel="noreferrer">Click That Hood</a>
              · Licencia <a href="/data/mapa-LICENSE.txt">MIT</a>.
            </p>
          </div>
          <div class="col-lg-4">
            <h3 class="h6 text-warning mb-3">Territorios destacados</h3>
            <div id="mapaLeyenda" class="d-grid gap-2" aria-live="polite"></div>
            <p id="mapaMensaje" class="text-secondary small mt-3 mb-0">
              El total nacional no corresponde a una comunidad concreta.
            </p>
            <p class="text-secondary small mt-3 mb-0">
              <span class="d-inline-flex align-items-center gap-2 me-3"><span class="mapa-clave mapa-clave-1"></span>Selección 1</span>
              <span class="d-inline-flex align-items-center gap-2"><span class="mapa-clave mapa-clave-2"></span>Selección 2</span>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/consulta-chart.js"></script>
</body>
</html>