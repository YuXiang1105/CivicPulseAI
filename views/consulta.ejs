<%
  const territorios = [
    ['Total Nacional', 'Total Nacional'],
    ['01 Andalucía', '01 Andalucía'],
    ['02 Aragón', '02 Aragón'],
    ['03 Asturias, Principado de', '03 Asturias, Principado de'],
    ['04 Balears, Illes', '04 Balears, Illes'],
    ['05 Canarias', '05 Canarias'],
    ['06 Cantabria', '06 Cantabria'],
    ['07 Castilla y León', '07 Castilla y León'],
    ['08 Castilla - La Mancha', '08 Castilla - La Mancha'],
    ['09 Cataluña', '09 Cataluña'],
    ['10 Comunitat Valenciana', '10 Comunitat Valenciana'],
    ['11 Extremadura', '11 Extremadura'],
    ['12 Galicia', '12 Galicia'],
    ['13 Madrid, Comunidad de', '13 Madrid, Comunidad de'],
    ['14 Murcia, Región de', '14 Murcia, Región de'],
    ['15 Navarra, Comunidad Foral de', '15 Navarra, Comunidad Foral de'],
    ['16 País Vasco', '16 País Vasco'],
    ['17 Rioja, La', '17 Rioja, La'],
    ['18 Ceuta', '18 Ceuta'],
    ['19 Melilla', '19 Melilla']
  ];
  const sexos = ['Ambos sexos', 'Hombres', 'Mujeres'];
  const edades = [
    'Total',
    'Menores de 16',
    'De 16 a 19 años',
    'De 20 a 24 años',
    'De 25 a 34 años',
    'De 35 a 44 años',
    'De 45 a 54 años',
    'De 55 a 64 años',
    '65 y más años'
  ];
%>
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CivicPulse AI · Datos Abiertos</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Iconos de Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-light">

  <!-- 1. BARRA SUPERIOR -->
  <nav class="navbar border-bottom border-secondary-subtle bg-black bg-opacity-25 px-3 py-2">
    <div class="container-fluid d-flex justify-content-between align-items-center gap-3">
      
      <!-- Logo -->
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2 m-0" href="#">
        <i class="bi bi-broadcast text-warning fs-4"></i>
        <span>CivicPulse <span class="text-warning">AI</span></span>
      </a>

      <!-- Etiqueta de fuente oficial -->
      <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle d-none d-md-inline-block">
        <i class="bi bi-database-check me-1"></i>Datos Abiertos · INE
      </span>

    </div>
  </nav>

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="container-fluid p-3 p-lg-4">

    <!-- 2. PANEL DE FILTROS (TARJETA HORIZONTAL) -->
    <div class="card bg-body-tertiary border-secondary-subtle rounded-4 shadow-sm mb-4">
      <div class="card-body p-3">
        <form id="filtrosForm" class="row g-3 align-items-end" method="POST">
          <% [1, 2].forEach(numero => { %>
          <div class="col-12">
            <h2 class="h6 text-warning mb-2">Selección <%= numero %></h2>
            <div class="row g-3">
              <div class="col-md-4">
                <label for="sexo<%= numero %>" class="form-label small text-secondary">Sexo</label>
                <select id="sexo<%= numero %>" name="sexo<%= numero %>" class="form-select form-select-sm bg-dark border-secondary" required>
                  <% sexos.forEach(sexo => { %>
                    <option value="<%= sexo %>" <%= filtros[`sexo${numero}`] === sexo ? 'selected' : '' %>><%= sexo %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-4">
                <label for="comunidad<%= numero %>" class="form-label small text-secondary">Territorio</label>
                <select id="comunidad<%= numero %>" name="comunidad<%= numero %>" class="form-select form-select-sm bg-dark border-secondary" required>
                  <% territorios.forEach(([valor, nombre]) => { %>
                    <option value="<%= valor %>" <%= filtros[`comunidad${numero}`] === valor ? 'selected' : '' %>><%= nombre %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-4">
                <label for="edad<%= numero %>" class="form-label small text-secondary">Edad</label>
                <select id="edad<%= numero %>" name="edad<%= numero %>" class="form-select form-select-sm bg-dark border-secondary" required>
                  <% edades.forEach(edad => { %>
                    <option value="<%= edad %>" <%= filtros[`edad${numero}`] === edad ? 'selected' : '' %>><%= edad %></option>
                  <% }); %>
                </select>
              </div>
            </div>
          </div>
          <% }); %>
          <div class="col-12">
            <button type="submit" id="btnMostrar" class="btn btn-warning btn-sm fw-semibold w-100">
              <i class="bi bi-bar-chart-line me-1"></i>Comparar selecciones
            </button>
          </div>
        </form>
      </div>
    </div>
    <p class="text-secondary small">El área inferior se rellena hasta la base; la superior, entre las dos selecciones.</p>
    <% if (typeof error !== 'undefined') { %>
      <div class="alert alert-warning" role="alert"><%= error %></div>
    <% } %>

    <!-- 3. ZONA DE RESULTADOS (IZQUIERDA VISUAL / DERECHA TARJETAS) -->
    <div class="row g-4">
      
      <!-- Columna izquierda: Comparación de áreas -->
      <div class="col-lg-8">
        <div class="card bg-body-tertiary border-secondary-subtle rounded-4 mb-4">
          <div class="card-body p-4">
            <h5 class="fw-semibold mb-3">Comparación de las dos selecciones</h5>
            <div style="height: 480px; position: relative;">
              <canvas
                id="graficaComparacion"
                data-series="<%= JSON.stringify(resultados.map(resultado => ({ label: resultado.etiqueta, data: resultado.series[0]?.Data.slice().reverse().map(dato => ({ year: dato.Anyo, value: dato.Valor })) || [] }))) %>"
                aria-label="Gráfica de áreas apiladas comparando las dos selecciones"
                role="img"></canvas>
            </div>
            <p id="graficaMensaje" class="text-secondary small mt-3 mb-0" aria-live="polite">
              Envía las dos selecciones para ver la comparación.
            </p>
          </div>
        </div>
      </div>

      <!-- Columna derecha (35%): Tarjetas Bento de decisión -->
      <div class="col-lg-4 d-flex flex-column gap-3">
        
        <!-- Tarjeta destacada de Recomendación / Análisis -->
        <div class="card bg-body-tertiary border-warning rounded-4 shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center gap-2 text-warning small fw-semibold mb-1">
              <i class="bi bi-lightbulb-fill"></i>
              <span>Análisis Inteligente</span>
            </div>
            <h5 class="fw-bold mb-1" id="tituloZona">Total Nacional · 2025</h5>
            <p class="text-light-emphasis small mb-0" id="textoRecomendacion">
              Selecciona una comunidad autónoma o tramo de edad para comparar su evolución respecto a la media nacional.
            </p>
          </div>
        </div>

        <div class="card bg-body-tertiary border-secondary-subtle rounded-4">
          <div class="card-body">
            <span class="text-secondary small d-block mb-1">
              Último dato · <span id="kpiAnio">—</span>
            </span>

            <div class="d-flex align-items-baseline gap-2 flex-wrap">
              <span class="display-6 fw-bold" id="kpiValor">—</span>
              <span class="badge rounded-pill" id="kpiVariacion"></span>
            </div>
            <div class="text-secondary small" id="kpiVariacionTexto">vs. año anterior</div>

            <hr class="border-secondary-subtle my-3">

            <div class="row g-2 small">
              <div class="col-12 d-flex justify-content-between">
                <span class="text-secondary">Vs. Total Nacional</span>
                <span class="fw-semibold" id="kpiVsNacional">—</span>
              </div>
              <div class="col-12 d-flex justify-content-between">
                <span class="text-secondary">Máximo histórico</span>
                <span class="fw-semibold" id="kpiMax">—</span>
              </div>
              <div class="col-12 d-flex justify-content-between">
                <span class="text-secondary">Mínimo histórico</span>
                <span class="fw-semibold" id="kpiMin">—</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/consulta-chart.js"></script>
</body>
</html>